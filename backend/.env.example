NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_IDLE_TIMEOUT_MINUTES=480

MONGO_URI=mongodb://localhost:27017/digital_menu
JWT_ACCESS_SECRET=dev_access_secret_replace_me_1234567890
JWT_REFRESH_SECRET=dev_refresh_secret_replace_me_1234567890
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=8h

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=digital-menu
S3_PUBLIC_BASE_URL=http://localhost:9000/digital-menu

EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_RECIPIENT_OVERRIDE=
EMAIL_FROM="Food Recipe System <no-reply@plvpilot.space>"

HOSTINGER_MAIL_API_TOKEN=your_hostinger_mail_api_token

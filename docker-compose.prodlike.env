COMPOSE_PROJECT_NAME=digital-menu-prodlike

FRONTEND_PORT=8080
BACKEND_HOST_PORT=3001
MONGO_HOST_PORT=27018
REDIS_HOST_PORT=6380
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

FRONTEND_VITE_API_URL=/api

PORT=3000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_IDLE_TIMEOUT_MINUTES=30
MONGO_URI=mongodb://mongo:27017/digital_menu
JWT_ACCESS_SECRET=local_prodlike_access_secret_1234567890
JWT_REFRESH_SECRET=local_prodlike_refresh_secret_0987654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REDIS_URL=redis://redis:6379
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
APP_BASE_URL=http://localhost:8080

MONGO_IMAGE=mongo:7
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MINIO_ROOT_USER=localminioadmin
MINIO_ROOT_PASSWORD=localminiosecret
S3_REGION=us-east-1
S3_ACCESS_KEY=localminioadmin
S3_SECRET_KEY=localminiosecret
S3_BUCKET=digital-menu
S3_ENDPOINT=http://minio.localhost:9002
S3_PUBLIC_BASE_URL=http://minio.localhost:9002/digital-menu

EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_RECIPIENT_OVERRIDE=
EMAIL_FROM=Digital Menu <no-reply@digitalmenu.local>
HOSTINGER_MAIL_API_TOKEN=hostinger_prodlike_test_token
HOSTINGER_MAILBOX_ID=
